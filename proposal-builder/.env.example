# ==============================================================================
# NET & SOFT SOLUTIONS - PROPOSAL BUILDER (.env.example)
# Portal Corporativo: https://netandsoft.com.ve/ (PROHIBIDO: netandsoft.es)
# Subdominio de Producción: https://cotiza.netandsoft.com.ve
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO Y SERVIDOR
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# URL pública de la aplicación
# Desarrollo local: http://localhost:3000
# Producción:       https://cotiza.netandsoft.com.ve
APP_URL=https://cotiza.netandsoft.com.ve

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (PostgreSQL 15 / 16)
# ------------------------------------------------------------------------------
# En docker-compose: postgresql://proposal_user:CHANGE_ME_PASSWORD@postgres:5432/proposal_builder?schema=public
DATABASE_URL=postgresql://proposal_user:CHANGE_ME_PASSWORD@localhost:5432/proposal_builder?schema=public

# Variables para docker-compose.yml:
POSTGRES_USER=proposal_user
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=proposal_builder
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. SEGURIDAD, SESIONES Y CRIPTOGRAFÍA (Argon2id / HMAC)
# ------------------------------------------------------------------------------
# Clave maestra para firma de cookies de sesión (generar con: openssl rand -hex 32)
AUTH_SECRET=GENERATE_RANDOM_HEX_32_CHARACTERS
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_HOURS=8

# ------------------------------------------------------------------------------
# 4. CREDENCIALES DE SEMILLA INICIAL (Seed Admin & Sales)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@netandsoft.com.ve
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5. CACHE Y RATE LIMITING DISTRIBUIDO (Redis 7)
# ------------------------------------------------------------------------------
# En docker-compose: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 6. PROTECCIÓN ANTI-BOT, HONEYPOT Y TOKENS FIRMADOS
# ------------------------------------------------------------------------------
# Clave para firmar tokens nonces de envío (generar con: openssl rand -hex 32)
FORM_TOKEN_SECRET=GENERATE_RANDOM_HEX_32_CHARACTERS

# Tiempo mínimo en segundos requerido para enviar el formulario (speed check)
FORM_MIN_SUBMIT_SECONDS=3

# Tiempo de vida máximo del token en minutos
FORM_TOKEN_TTL_MINUTES=30

# Rate limits de seguridad
RATE_LIMIT_PROPOSAL_ATTEMPTS=5
RATE_LIMIT_PROPOSAL_WINDOW_SECONDS=600
RATE_LIMIT_GLOBAL_ATTEMPTS=10
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. CAPTCHA SECUNDARIO (Cloudflare Turnstile - Opcional)
# ------------------------------------------------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 8. NOTIFICACIONES POR CORREO (SMTP - Transaccional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cotiza@netandsoft.com.ve
SMTP_PASSWORD=
SMTP_FROM="Net & Soft Solutions <cotiza@netandsoft.com.ve>"

# ------------------------------------------------------------------------------
# 9. INTEGRACIÓN GOHIGHLEVEL (CRM Webhook - Backend Only)
# ------------------------------------------------------------------------------
GHL_ENABLED=false
GHL_WEBHOOK_URL=
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 10. ANALÍTICA Y SEGUIMIENTO (Opcional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
